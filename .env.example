# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# Matterport API token (ID + secret, used together as HTTP Basic auth)
MATTERPORT_TOKEN_ID=
MATTERPORT_TOKEN_SECRET=

# Photon Beta (2.0) iMessage: project id (pho_prj_...) and project API key (pho_sk_...) from app.beta.photon.codes
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# Phone number to text during development (E.164, e.g. +16095551234); prefilled in the dashboard's 911 form
DEV_TEST_PHONE=

# "simulated" (default: caller replies typed on the dashboard) or "photon" (real iMessage via messaging/ sidecar)
MESSAGING_MODE=simulated
MESSAGING_SIDECAR_URL=http://localhost:8787
BACKEND_URL=http://localhost:8000

# Optional: Claude reads caller replies and words follow-ups (backend/app/llm.py). Empty = keyword rules.
ANTHROPIC_API_KEY=

# Optional: Vexcel aerial orthophoto around the building for the map view (backend/app/geo.py). Hackathon keys
# cover Houston and Los Angeles only; elsewhere Vexcel answers 403 and the map shows the plan alone. Empty = off.
VEXCEL_API_KEY=
# Optional: Google Maps JavaScript API key for the dashboard's map view. Sent to the browser (browser keys are public
# by design), so restrict it by HTTP referrer in the Google Cloud console.
# Optional: Street View Static image on the approach card. Browser-visible: restrict it to that API.
GOOGLE_MAPS_API_KEY=
